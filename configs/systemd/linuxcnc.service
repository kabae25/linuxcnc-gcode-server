[Unit]
Description=LinuxCNC Core Motion Engine
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi
# ExecStart uses -r flag to automatically restart without interactive Y/n prompt
ExecStart=/usr/bin/linuxcnc -r /home/pi/linuxcnc/configs/rotary_table/rotary_table.ini
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
