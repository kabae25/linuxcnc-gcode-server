[Unit]
Description=LinuxCNC Core Motion Engine
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi
# Replace with your actual machine INI file path
ExecStart=/usr/bin/linuxcnc /home/pi/linuxcnc/configs/rotary_table/rotary_table.ini
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
